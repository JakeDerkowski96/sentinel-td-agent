{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JakeDerkowski96/sentinel-td-agent/contracts/agent-run-record.v1.schema.json",
  "title": "Agent run record v1",
  "description": "Audit record written for every run, sufficient to explain a proposal later.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "started_at",
    "outcome",
    "trigger",
    "model",
    "tool_calls",
    "cost"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "enum": [
        "proposed",
        "stopped_insufficient_evidence",
        "stopped_policy",
        "stopped_budget",
        "failed",
        "dry_run"
      ]
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "object",
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "model_id",
        "region",
        "prompt_version"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "guardrail_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "state",
          "tool",
          "args_hash",
          "result_summary"
        ],
        "properties": {
          "state": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "args_hash": {
            "type": "string",
            "minLength": 1
          },
          "result_summary": {
            "type": "string",
            "minLength": 1
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "usd"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "pr_url": {
      "type": "string",
      "minLength": 1
    }
  }
}
